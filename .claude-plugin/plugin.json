{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "faa-traffic-delays-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for FAA Air Traffic Control System Command Center status: ground stops, ground delay programs, airspace flow programs, and airport arrival/departure delays.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/faa-traffic-delays-mcp-server",
  "repository": "https://github.com/cyanheads/faa-traffic-delays-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "faa",
    "air-traffic",
    "flight-delays",
    "ground-stop",
    "aviation"
  ],
  "mcpServers": {
    "faa-traffic-delays-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/faa-traffic-delays-mcp-server"
      ],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
